# Copier en .env. Aucune clé ici.
# Modèle compatible OpenAI (Ollama, vLLM, LM Studio, ou API autorisée)
# Hors Docker : http://localhost:11434/v1 ; avec le service ollama du docker-compose : http://ollama:11434/v1
HQA_LLM_BASE_URL=http://ollama:11434/v1
HQA_LLM_MODEL=
HQA_LLM_API_KEY=
# Doit valoir "yes" pour autoriser l'envoi de données pseudonymisées du registre au service ci-dessus.
# À ne positionner qu'après confirmation de l'environnement et de l'autorisation de traitement.
HQA_ALLOW_REGISTRY_DATA_TO_LLM=no
# Référence de l'autorisation (exigée avec yes), recopiée dans les manifestes. Ex. :
# HQA_LLM_AUTHORIZATION_REF=modèle local uniquement, accord du responsable du registre du 2026-10-24
HQA_LLM_AUTHORIZATION_REF=

# --- Docker ---
# UID/GID de l'utilisateur de l'hôte propriétaire de ./data et ./runs (commande : id -u ; id -g)
HQA_UID=1000
HQA_GID=1000
# port local de l'interface de revue (publié sur 127.0.0.1 uniquement)
HQA_REVIEW_PORT=8501

# --- Passerelle QA (agents RAISE) ---
# clé exigée dans l'en-tête X-API-Key (>= 24 caractères) : python3 -c "import secrets;print(secrets.token_urlsafe(32))"
HQA_API_KEY=
# interface d'écoute publiée : 127.0.0.1 si RAISE est sur le même serveur ; IP privée/0.0.0.0 derrière pare-feu sinon
HQA_GATEWAY_BIND=127.0.0.1
HQA_GATEWAY_PORT=8095

# --- Page de bilan (service site, nginx statique) ---
# 127.0.0.1 par défaut (tunnel SSH) ; 0.0.0.0 pour la publier sur le réseau (agrégats uniquement)
HQA_SITE_BIND=127.0.0.1
HQA_SITE_PORT=8097
