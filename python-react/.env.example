# Copiez ce fichier en .env et changez les valeurs
DB_NAME=hemostase
DB_USER=hemostase
DB_PASSWORD=changez-moi
DB_ROOT_PASSWORD=changez-moi-aussi

# Clé de signature des jetons (64 caractères aléatoires : openssl rand -hex 32)
JWT_SECRET=changez-moi-changez-moi-changez-moi-changez-moi-changez

# Mot de passe du compte "admin" créé au premier démarrage
ADMIN_PASSWORD=admin
# Utilisé UNIQUEMENT au premier démarrage (base vide) ; ensuite, changer le mot de passe dans l'interface.
# Évitez $ & | \ # et les guillemets : Docker Compose ou sed peuvent les transformer.

# true = crée aussi un compte de démonstration user/user (à éviter sur un serveur accessible)
CREATE_DEFAULT_USER=false

# true = charge les fiches fictives de JHipster si les tables sont vides
SEED_DEMO_DATA=false

# Ports publiés sur le serveur (plage de la solution : 18500-18509, voir deploiement/README.md)
HTTP_PORT=18500
# 0.0.0.0 = accessible depuis le réseau ; 127.0.0.1 = derrière un reverse proxy ou un tunnel SSH
HTTP_BIND=0.0.0.0
# origine(s) autorisée(s) par l'API si l'interface est servie ailleurs (séparées par des virgules)
CORS_ORIGINS=http://localhost:18500

# Mode développement (docker-compose.dev.yml), publiés sur 127.0.0.1 seulement
DEV_WEB_PORT=5173
DEV_API_PORT=8000
DEV_DB_PORT=3306
